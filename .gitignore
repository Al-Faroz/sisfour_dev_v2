# ================================================================
# SisisFour - .gitignore
# MTsN 4 Jombang
# ================================================================

# --- Environment & Config ---
.env

# --- Dependencies (composer install ulang dari composer.json) ---
/vendor/

# --- PHPUnit / build artifacts ---
/build/

# --- Writable (CodeIgniter 4) ---
/writable/logs/*
!/writable/logs/index.html

/writable/session/*
!/writable/session/index.html

/writable/cache/*
!/writable/cache/index.html

/writable/backups/*
!/writable/backups/index.html

/writable/debugbar/*
!/writable/debugbar/index.html

# Upload Personalia tersimpan non-public dan tidak boleh masuk repository.
/writable/uploads/*
!/writable/uploads/index.html

# --- Uploads Dinamis (data siswa/guru/pegawai, tidak ikut Git) ---
/uploads/foto_siswa/*
/uploads/foto_guru/*
/uploads/foto_pegawai/*
/uploads/branding/*
/uploads/kartu_pelajar/**/*
!/uploads/**/.htaccess
!/uploads/**/index.html

# --- IDE / OS ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Testing ---
# Source test tetap boleh di-commit; hanya hasil runtime/build yang diabaikan.
# tests/  <- uncomment jika ingin exclude folder test dari repo
